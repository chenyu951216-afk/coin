# CoinGlass Standard API
COINGLASS_API_KEY=
COINGLASS_EXCHANGE=Bitget
COINGLASS_SYMBOL=AUTO

# Research defaults. START/END are intentionally blank: the web/CLI automatically
# selects the maximum safe CoinGlass Standard window for the chosen timeframe.
SYMBOL=ETHUSDT
TIMEFRAME=15m
START=
END=
INITIAL_EQUITY=10000
RISK_PER_TRADE=0.01
TAKER_FEE_BPS=6
SLIPPAGE_BPS=2
MIN_ALIGNED_COVERAGE=0.90

# Zeabur build/runtime
ZBPACK_DOCKERFILE_PATH=Dockerfile
PORT=8080
ADMIN_BEARER_TOKEN=
ARTIFACT_ROOT=artifacts/zeabur

# Bitget exchange layer
BITGET_REST_BASE_URL=https://api.bitget.com
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT
BITGET_POSITION_MODE=one_way_mode
BITGET_MARGIN_MODE=isolated
BITGET_LEVERAGE=5

# Execution risk caps. These size orders only; they never alter strategy entry/SL/TP.
MAX_POSITION_NOTIONAL_EQUITY_MULTIPLE=2.0
MAX_PORTFOLIO_NOTIONAL_EQUITY_MULTIPLE=5.0
AVAILABLE_MARGIN_UTILIZATION_PCT=0.70

# Keep hard locked while researching/paper-validating.
LIVE_TRADING_ENABLED=false

# Continuous Bitget whole-market scanner
SCAN_TIMEFRAME=15m
SCAN_LOOKBACK_BARS=180
SCAN_MIN_ALIGNED_ROWS=110
SCAN_MIN_TURNOVER_USDT=1000000
SCAN_MAX_SPREAD_PCT=0.50
# 0 = every Bitget contract that survives public liquidity filtering.
SCAN_MAX_SYMBOLS=0
# Starts automatically after service boot when COINGLASS_API_KEY exists.
SCAN_AUTO_START=true
# Wait a few seconds after candle close before scanning so all sources can finalize.
SCAN_GRACE_SECONDS=8
# Retry delay after a temporary data/API error.
SCAN_ERROR_RETRY_SECONDS=120
