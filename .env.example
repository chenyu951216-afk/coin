# CoinGlass Standard API
COINGLASS_API_KEY=
COINGLASS_EXCHANGE=Bitget
COINGLASS_SYMBOL=AUTO

# Research defaults. START/END intentionally blank: system automatically selects
# the maximum safe CoinGlass Standard window for the chosen timeframe.
SYMBOL=ETHUSDT
TIMEFRAME=15m
START=
END=
INITIAL_EQUITY=10000
# Legacy only; paper/backtest sizing below is fixed-notional.
RISK_PER_TRADE=0.01
TAKER_FEE_BPS=6
SLIPPAGE_BPS=2
MAX_ESTIMATED_COST_R=0.18
MIN_ALIGNED_COVERAGE=0.90

# Fixed simulated-order notionals.
# Entry market price > 50U => 20,000U notional; <= 50U => 2,000U notional.
PAPER_LOW_NOTIONAL_USDT=2000
PAPER_HIGH_NOTIONAL_USDT=20000
PAPER_HIGH_PRICE_THRESHOLD=50

# Whole-market historical backtest.
# Historical liquidity is computed only from bars already completed at that past timestamp.
MARKET_BACKTEST_MIN_24H_TURNOVER_USDT=1000000
# 0 = every eligible current Bitget contract. Positive values are debug caps only.
MARKET_BACKTEST_MAX_SYMBOLS=0
MARKET_BACKTEST_MIN_ALIGNED_ROWS=500
# Point this to a persistent Zeabur disk path if available so repeated runs reuse real-data cache.
MARKET_CACHE_ROOT=artifacts/market_cache

# Zeabur build/runtime
ZBPACK_DOCKERFILE_PATH=Dockerfile
PORT=8080
ADMIN_BEARER_TOKEN=
ARTIFACT_ROOT=artifacts/zeabur

# Bitget exchange layer
BITGET_REST_BASE_URL=https://api.bitget.com
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT
BITGET_POSITION_MODE=one_way_mode
BITGET_MARGIN_MODE=isolated
BITGET_LEVERAGE=5

# Live execution caps. Live execution remains independent from paper fixed-notional sizing
# until the market-wide portfolio/execution-arbitration layer passes validation.
MAX_POSITION_NOTIONAL_EQUITY_MULTIPLE=2.0
MAX_PORTFOLIO_NOTIONAL_EQUITY_MULTIPLE=5.0
AVAILABLE_MARGIN_UTILIZATION_PCT=0.70
LIVE_TRADING_ENABLED=false

# Continuous Bitget whole-market scanner
SCAN_TIMEFRAME=15m
SCAN_LOOKBACK_BARS=180
SCAN_MIN_ALIGNED_ROWS=110
SCAN_MIN_TURNOVER_USDT=1000000
SCAN_MAX_SPREAD_PCT=0.50
SCAN_MAX_SYMBOLS=0
SCAN_AUTO_START=true
SCAN_GRACE_SECONDS=8
SCAN_ERROR_RETRY_SECONDS=120
