# CoinGlass Standard API
COINGLASS_API_KEY=
# Final execution venue is Bitget; AUTO maps Bitget symbols to CoinGlass instrument IDs.
COINGLASS_EXCHANGE=Bitget
COINGLASS_SYMBOL=AUTO

# Single-symbol backtest defaults. Web UI can override SYMBOL/period/timeframe per run.
SYMBOL=ETHUSDT
TIMEFRAME=15m
START=2025-01-01T00:00:00Z
END=2026-01-01T00:00:00Z
INITIAL_EQUITY=10000
RISK_PER_TRADE=0.01
TAKER_FEE_BPS=6
SLIPPAGE_BPS=2
MIN_ALIGNED_COVERAGE=0.90

# Zeabur build/runtime
# Explicitly force the repository-root Dockerfile. Do not set ZBPACK_IGNORE_DOCKERFILE=true.
ZBPACK_DOCKERFILE_PATH=Dockerfile
PORT=8080
ADMIN_BEARER_TOKEN=
ARTIFACT_ROOT=artifacts/zeabur

# Bitget exchange layer
BITGET_REST_BASE_URL=https://api.bitget.com
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT
BITGET_POSITION_MODE=one_way_mode
BITGET_MARGIN_MODE=isolated
BITGET_LEVERAGE=5

# Execution risk caps. These size orders only; they do NOT change strategy SL/TP.
MAX_POSITION_NOTIONAL_EQUITY_MULTIPLE=2.0
MAX_PORTFOLIO_NOTIONAL_EQUITY_MULTIPLE=5.0
AVAILABLE_MARGIN_UTILIZATION_PCT=0.70

# Hard live-trading lock. Keep false while researching/paper-validating.
LIVE_TRADING_ENABLED=false

# Whole Bitget-market scanner
SCAN_TIMEFRAME=15m
SCAN_LOOKBACK_BARS=180
SCAN_MIN_ALIGNED_ROWS=110
SCAN_MIN_TURNOVER_USDT=1000000
SCAN_MAX_SPREAD_PCT=0.50
# 0 = scan every Bitget contract surviving the public liquidity prefilter.
SCAN_MAX_SYMBOLS=0
